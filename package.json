{
  "name": "@gubkin-labs/aleph-cli",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Cross-platform CLI for publishing and managing Aleph agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gubkin-labs/aleph-cli.git"
  },
  "homepage": "https://github.com/gubkin-labs/aleph-cli#readme",
  "bugs": {
    "url": "https://github.com/gubkin-labs/aleph-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "aleph": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "ultracite check",
    "commitlint": "commitlint",
    "fix": "ultracite fix",
    "openapi:fetch": "tsx scripts/openapi-fetch.ts",
    "openapi:generate": "openapi-typescript openapi/openapi.json -o src/generated/schema.d.ts",
    "openapi:check": "openapi-typescript openapi/openapi.json -o src/generated/schema.d.ts --check",
    "openapi": "pnpm openapi:fetch && pnpm openapi:generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "quality": "pnpm fix && pnpm typecheck && pnpm check && pnpm test && pnpm build && pnpm openapi:check",
    "prepare": "husky",
    "prepack": "pnpm quality",
    "package:binaries": "pnpm build && pkg package.json --compress GZip --out-path release",
    "release": "semantic-release",
    "start": "node dist/cli.js"
  },
  "pkg": {
    "assets": [
      "node_modules/@napi-rs/keyring/**/*"
    ],
    "outputPath": "release",
    "targets": [
      "node22-linux-x64",
      "node22-linux-arm64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-win-x64"
    ]
  },
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "open": "^11.0.0",
    "openapi-fetch": "^0.17.0",
    "p-limit": "^7.3.1",
    "react": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "22.15.0",
    "@types/react": "^19.2.17",
    "@yao-pkg/pkg": "^6.21.0",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "semantic-release": "25.0.8",
    "tsx": "^4.23.1",
    "typescript": "5.8.3",
    "ultracite": "7.8.3",
    "vitest": "^4.1.10"
  }
}
